# Required for provisioning the public /metabase administration surface.
# Copy to .env and set deployment-specific values; never commit the populated file.
POSTGRES_USER=
POSTGRES_PASSWORD=
METABASE_ADMIN_EMAIL=
METABASE_ADMIN_PASSWORD=
# Server-owned gateway identity for backend verification; this is not a browser login.
APP_ADMIN_USER=
APP_ADMIN_PASSWORD=
# Gateway edge Basic Auth: defaults to on. Set to false only for controlled LAN acceptance;
# the nginx entrypoint logs a warning and the gateway becomes open to any reachable client.
GATEWAY_BASIC_AUTH_ENABLED=true
# Optional real per-user mode for +1 deep links. Encode a bcrypt htpasswd file whose usernames
# exactly match InternalOperator.wecom_userid; use an independent random 32+ character token.
APP_OPERATOR_HTPASSWD_B64=
APP_GATEWAY_ASSERTION_TOKEN=
# Independent identity for internal service calls. Docker Compose order-assistant requires both values
# and uses them only for the explicitly dual-authenticated /demo/v1/extracted-orders seam.
APP_INTERNAL_SERVICE_NAME=
APP_INTERNAL_SERVICE_TOKEN=
APP_BIND_ADDRESS=127.0.0.1

# JD writes remain disabled unless both the write gate and an authenticated
# operator allowlist are set explicitly. Use the same login name as APP_ADMIN_USER.
JD_LOP_WRITE_MODE=OFF
# 通用 JD 写 HTTP 面不属于 Shipment 建单验收，Compose 始终保持 OFF。
JD_OUTBOUND_AUTHORIZED_OPERATORS=
# querySoOrder 运单回填轮询默认关闭；手动入口不受此开关影响。
JD_TRACKING_BACKFILL_ENABLED=false
JD_TRACKING_BACKFILL_POLL_MS=60000
JD_TRACKING_BACKFILL_BATCH_SIZE=20
JD_TRACKING_BACKFILL_MIN_INTERVAL=PT1M

# 中汇 PMS 默认只启用 MOCK；即使改为 REAL，外部登录/传图/建品仍须显式开启第二道写门闩。
ZHONGHUI_PMS_CLIENT_MODE=MOCK
ZHONGHUI_PMS_WRITE_MODE=OFF
ZHONGHUI_PMS_REQUEST_TIMEOUT=PT30S
ZHONGHUI_PMS_IDEMPOTENCY_LEASE=PT40M
ZHONGHUI_PMS_BASE_URL=
ZHONGHUI_PMS_USERNAME=
ZHONGHUI_PMS_PASSWORD=
ZHONGHUI_PMS_DEFAULT_BRAND_ID=
ZHONGHUI_PMS_DEFAULT_CERTIFICATION_TYPE=
ZHONGHUI_PMS_DEFAULT_CERTIFICATION_ID=
ZHONGHUI_PMS_DEFAULT_THIRD_ID=
ZHONGHUI_PMS_DEFAULT_LIMIT_AREA_TEMP_ID=
ZHONGHUI_PMS_DEFAULT_GOODS_TAX=
ZHONGHUI_PMS_DEFAULT_LOGISTICS_CARRIER=
ZHONGHUI_PMS_DEFAULT_PRODUCING_AREA=
ZHONGHUI_PMS_DEFAULT_GOODS_NUM=99
ZHONGHUI_PMS_DEFAULT_SALE_UNIT=件
ZHONGHUI_PMS_DEFAULT_ORIGIN_COUNTRY=1

# Enterprise WeChat intelligent-bot long connection (replaces the HTTP callback mode).
# BotID and the long-connection Secret come from the WeCom admin console. Keep secrets
# only in the git-ignored backend/.env.wecom.local file (0600, like .env.jd.uat.local)
# or the deployment environment; never commit or log them.
WECOM_ENABLED=false
WECOM_BOT_ID=
WECOM_SECRET=
WECOM_HEARTBEAT_INTERVAL_SECONDS=30

# Real message interpreter (DeepSeek OpenAI-compatible). Only wired via environment variables;
# the api-key must never be committed or logged. Provider/model/prompt-version triples must be
# registered in the PUBLIC_*_ALIAS values below or interpretation results collapse to the sentinel.
MESSAGE_INTERPRETER_BASE_URL=
MESSAGE_INTERPRETER_API_KEY=
MESSAGE_INTERPRETER_PROVIDER=deepseek
MESSAGE_INTERPRETER_MODEL=deepseek-chat
MESSAGE_INTERPRETER_PROMPT_VERSION=wecom-interpret-v1
MESSAGE_INTERPRETER_REQUEST_TIMEOUT_MS=30000
MESSAGE_INTERPRETER_PUBLIC_PROVIDER_ALIAS=deepseek
MESSAGE_INTERPRETER_PUBLIC_MODEL_ALIAS=deepseek-chat
MESSAGE_INTERPRETER_PUBLIC_PROMPT_VERSION_ALIAS=wecom-interpret-v1

# ---- 三平台在线接入（Phase 1，ticket 07/08/09/12）----
# 凭据只走环境变量，绝不入库/入日志；HAR 与 data-local/*-credentials.txt 勿提交、定期改密。
# Phase 1 Java Connector 读取（一期单实例内存会话缓存，多实例需分布式锁）。
CSX_USERNAME=
CSX_PASSWORD=
CSX_SUPPLIER_CODE=20075684
CSX_SHIPMENT_VERIFY_ATTEMPTS=5
CSX_SHIPMENT_VERIFY_DELAY=PT2S
JUFUBAO_ENABLED=false
JUFUBAO_USERNAME=
JUFUBAO_PASSWORD=
JUFUBAO_API_BASE=https://supplier-apis.jufubao.cn
JUFUBAO_PORTAL_BASE=https://g.jufubao.cn
JUFUBAO_STATE_POLL_ATTEMPTS=5
JUFUBAO_STATE_POLL_DELAY=PT2S
SOURCE_SYNC_IDEMPOTENCY_LEASE=PT10M
SOURCE_SYNC_RECOVERY_ENABLED=true
SOURCE_SYNC_RECOVERY_INITIAL_DELAY_MS=60000
SOURCE_SYNC_RECOVERY_POLL_MS=60000
SOURCE_SYNC_RECOVERY_BATCH_SIZE=50
# 历史部署若仍使用 JFUBAO_USERNAME/JFUBAO_PASSWORD 也可兼容；新配置统一使用上面的规范名。
FEIXIANG_ENABLED=false
FEIXIANG_USERNAME=
FEIXIANG_PASSWORD=

# Agent 进程内工具面（app.agent.tool-modules，env AGENT_TOOL_MODULES）。这是 Agent 运行时
# 绑定工具的模块面，与下面的外部 MCP 协议面**互相独立**；最终权限仍由每个 Agent 的
# tool_whitelist + allow_write 判定；显式空值 = 零工具，写错模块名后端启动期直接失败。
# 默认值取全部业务模块，让本仓迁移自带的 7 个种子 Agent 全部绑定成功。为什么不能少开：
# AgentToolBindingFactory 对白名单里找不到的工具是**直接抛 IllegalArgumentException**，
# 不是跳过——少开一个模块的后果是对应 Agent 一开跑就整个失败，而不是少一个工具可用。
# 各模块由谁需要（删减时对照）：
#   masterdata + inventory + procurement  procurement-price-agent
#   ↑ 再加 messages                       data-query-agent
#   orders                                source-sync-reviewer / fulfillment-file-agent
#   control + write                       meta-agent（唯一 allow_write=true 的种子 Agent）
#   followup                              customer-followup-agent
# orders-read / bundles-read 没有种子 Agent 白名单引用，默认仍开着供后续 Agent 使用，
# 关掉也不影响现有种子 Agent。followup / messages 含客户姓名、电话、地址（PII）；
# write 含 submit_jd_outbound、confirm_order_draft 这类真实写动作——按环境需要自行删减。
AGENT_TOOL_MODULES=messages,orders,masterdata,inventory,procurement,orders-read,bundles-read,followup,control,write

# MCP 外部协议工具面按模块开放。**留空 = 不开放任何 MCP 工具**：stdio 面与公网
# HTTP 面都拿不到工具，tools/list 为空且 tools/call 一律按「工具不存在」拒绝。想用 MCP 就必须
# 在这里显式列出模块名；写错模块名后端启动期直接失败（错误信息会列出已知模块全集）。
# 已声明模块：masterdata / inventory / orders / orders-read / messages / followup /
# procurement / bundles-read / control / write。followup 与 messages 含客户姓名/电话/地址，
# write 含 submitJdOutbound 这类真实下单动作——只在确有需要的环境里才加进来（协议面另有
# 只读门禁，写工具即使误配也不会被发现/调用）。注意 default 不是可配置的模块名——它只是
# McpTool.module() 的接口兜底值，实际没有任何工具声明它，写进这一行会被当作未知模块名而启动失败。
# 新部署可改用 MCP_PROTOCOL_MODULES：未设置时回退下面的旧变量，显式空则覆盖旧值。
# 下面保留生产当前显式配置（只读三模块）。生产在 offline.runtime.override.yml 里显式配置
# 这三模块——那个 override 是 docker compose 四个 -f 里的最后一个，覆盖 base
# docker-compose.yml 的 ${MCP_MODULES:-}。改生产开放面请改那个 override
# （部署守门见 docs/ops/deploy-runbook.md），不要只改这里。
MCP_MODULES=masterdata,inventory,orders-read

# Agent 运行时（app.agent.*，与 MESSAGE_INTERPRETER_* 相互独立）
AGENT_PROVIDER=deepseek
AGENT_MODEL=deepseek-chat
AGENT_BASE_URL=
AGENT_API_KEY=

# Kehuzx private MCP. Read/write tokens must be distinct; the signing key must
# exactly match the independently deployed Kehuzx service.
KEHUZX_MCP_ENABLED=false
KEHUZX_MCP_ENDPOINT=http://kehuzx-mcp:9100/mcp
KEHUZX_MCP_FOLLOWUP_READ_TOKEN=
KEHUZX_MCP_WRITE_ENABLED=false
KEHUZX_MCP_WRITE_ENDPOINT=http://kehuzx-mcp:9100/mcp
KEHUZX_MCP_WRITE_TOKEN=
KEHUZX_MCP_APPROVAL_SIGNING_KEY=
FOLLOWUP_ASSIGNMENT_WORKER_ENABLED=false

# 企微业务卡（#87/#88）：复核事项 / 运营告警 / 整批确认播报 / 京东出库失败
# 四类卡都是系统产生的，没有原会话可回，必须显式配置目标群；不配即不发。
WECOM_BUSINESS_CARD_ENABLED=
# 卡片深链的后台基地址；不配则卡片只带信息不带跳转（宁可不跳，也不发点了 404 的链接）
WECOM_BUSINESS_CARD_BASE_URL=
# 四类业务卡各自的目标群 chatid；未配即不发。群聊路由要求渲染侧脱敏（收件人姓名/手机/详址不进群）
WECOM_CARD_REVIEW_CHAT_ID=
WECOM_CARD_ALERT_CHAT_ID=
WECOM_CARD_BATCH_CHAT_ID=
WECOM_CARD_JD_OUTBOUND_CHAT_ID=
WECOM_CARD_REVIEW_CHAT_ID=
WECOM_CARD_ALERT_CHAT_ID=
WECOM_CARD_BATCH_CHAT_ID=
WECOM_CARD_JD_OUTBOUND_CHAT_ID=
# 定时拉取与自动发货的运行播报卡：卡面只有渠道名、受控词表原因码与计数，
# 没有收件人任何字段，因此可以进群（对比 preship：卡面带手机号与详址，源码里硬过滤单聊）
WECOM_CARD_SCHEDULED_PULL_ROUTE_TYPE=GROUP
WECOM_CARD_SCHEDULED_PULL_CHAT_ID=

# 定时来源渠道拉取：每个渠道早/晚各一次，时间在「系统 · 渠道接入」页按渠道设，
# 改完即时生效不用重启；仍受 SCHEDULING_ENABLED 总开关管
SCHEDULED_PULL_ENABLED=true
# 每分钟跳一次，跳的时候逐渠道问「你现在该拉了吗」
SCHEDULED_PULL_TICK_CRON=0 * * * * *
# 渠道没配过时实际生效的时间。不是「不拉」的开关：读不到配置一律按这两个时刻拉，
# 停某一档必须在界面上显式关掉（「空值 = 不拉」会让配置读取故障变成安静停摆）
SCHEDULED_PULL_DEFAULT_MORNING_AT=09:00
SCHEDULED_PULL_DEFAULT_EVENING_AT=18:00
# 补偿窗口（分钟）：重启/停顿错过了配置时刻，这么久之内每一跳都会重试；
# 重复由 scheduled_pull_runs.run_key 唯一约束挡住，窗口不跨零点
SCHEDULED_PULL_CATCH_UP_MINUTES=30
SCHEDULED_PULL_ZONE=Asia/Shanghai
# 自动发货独立开关，默认关。确认发货会向京东建真实出库单，是花真钱的动作，
# 不该因为升了个版本就自己开始跑。开启需两件事同时做到：
#   1) SCHEDULED_AUTO_SHIP_ENABLED=true
#   2) 把 system:scheduled-pull 加进 JD_OUTBOUND_AUTHORIZED_OPERATORS
# 第 2 条不是本特性发明的门闩，是 ShipmentJdOutboundService#requireAuthorized 既有的授权面
SCHEDULED_AUTO_SHIP_ENABLED=false
# 单次运行最多自动确认多少个批次：出了问题的爆炸半径必须有上界，剩余的下一个时段继续
SCHEDULED_AUTO_SHIP_BATCH_LIMIT=20

# 来源平台自动回传（往客户平台写数据；默认关。开启需同时配 OPERATOR，否则 fail-closed 不启动）
SOURCE_SYNC_AUTO_ENABLED=
SOURCE_SYNC_AUTO_OPERATOR=
