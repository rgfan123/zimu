# Required for provisioning the public /metabase administration surface.
# Copy to .env and set deployment-specific values; never commit the populated file.
METABASE_ADMIN_EMAIL=
METABASE_ADMIN_PASSWORD=
APP_ADMIN_USER=
APP_ADMIN_PASSWORD=

# Enterprise WeChat intelligent-bot HTTP callback. Keep secrets only in the
# deployment environment; group ids can be a comma-separated allowlist.
WECOM_BUSINESS_RELAY_ENABLED=false
WECOM_CORP_ID=
WECOM_BOT_ID=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_ALLOWED_GROUP_IDS=
