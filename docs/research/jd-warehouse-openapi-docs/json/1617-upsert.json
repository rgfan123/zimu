      "var client = new DefaultLopClient(new Uri(server_url),app_key, app_secret, refresh_token);\nvar request = new IntegratedsupplychainBasicinfoSupplierCreateV1LopRequest\n{\n\tRequest = new SupplierModelRequest\n\t{\n\t\tOwnerNo = \"EBU0000000000666\",\n\t\tErpSupplierNo = \"1000\",\n\t\tSupplierNo = \"EMS0000000000001\",\n\t\tSupplierName = \"北京分公司\",\n\t\tStatus = \"2\",\n\t\tPictureUrls = new System.Collections.Generic.List<string>\n\t\t{\n\t\t\t new string\n\t\t},\n\t\tMedicineEnterpriseNature = \"1\",\n\t\tPin = \"123\",\n\t\tSupplierAddress = new Address\n\t\t{\n\t\t\tName = \"刘星\",\n\t\t\tPhone = \"13988888888\",\n\t\t\tFax = \"0755-33168816\",\n\t\t\tEmail = \"2628896666Aqq.com\",\n\t\t\tProvince = \"吉林\",\n\t\t\tCity = \"辽源市\",\n\t\t\tCounty = \"龙山区\",\n\t\t\tTown = \"寿山镇\",\n\t\t\tDetailAddress = \"北京通州区六环以外（张家湾镇、台湖镇、漷县镇）西罗园南里100号900\",\n\t\t},\n\t\tSocialCreditCode = \"1\",\n\t},\n};\nvar response = client.Execute(request);\n",
